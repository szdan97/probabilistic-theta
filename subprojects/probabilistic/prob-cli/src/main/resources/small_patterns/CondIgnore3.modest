bool target;

property MaxTarget = Pmax(<> target);
property MinTarget = Pmin(<> target);

const int AMax = 3;
const int BMax = 3;
const int CMax = 3;
const int DMax = 3;

// Sooo this shouldnt work as well, but somehow, it does, at least with PRED
// it seems that most of the reduction for CondIgnore2 comes from merging all A>1 and B>1 together,
// instead of fully ignoring A or B
// EXPL is still able to reduce the size from 117 to 35/83: it never cares about A, B and C at the same time
// Until C is selected, it's value does not matter (although as it has a deterministic init, this does not reduce the size)
// After C is selected, either A or B does not matter
// Of course this is equivalent to having a palt instead of a late-selected C, but as mentioned earlier,
// any model could be directly written in its reduced version, but we don't want to do it manually
process ConditionalIgnore3() {
    int(0..AMax) A;
    int(0..BMax) B;
    int(0..CMax) C;
    {= A = DiscreteUniform(0,AMax) =};
    {= B = DiscreteUniform(0,BMax) =};
    {= C = DiscreteUniform(0,2) =};
    if(C == 0) {
        {= target = A > 1 =}
    } else {
        {= target = B > 1 =}
    }
}

ConditionalIgnore3()