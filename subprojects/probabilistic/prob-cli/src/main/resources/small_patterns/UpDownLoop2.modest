bool target;

property MaxTarget = Pmax(<> target);
property MinTarget = Pmin(<> target);

const int AMax = 3;

// Well, this works. But seems to not make much sense.
process UpDownLoop2() {
    int(0..AMax) A;
    int X = 0;
    {= A = DiscreteUniform(0,AMax) =};
    do {
        :: {= X++ =}
        :: {= X-- =}
        :: when(X == A) break
    };
    {= target = false =}
}

UpDownLoop2()