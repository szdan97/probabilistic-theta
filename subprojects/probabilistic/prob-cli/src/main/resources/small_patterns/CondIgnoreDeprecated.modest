bool target;

property MaxTarget = Pmax(<> target);
property MinTarget = Pmin(<> target);

const int AMax = 3;
const int BMax = 3;
const int CMax = 3;

// This example works quite well, but seems contrived
process ConditionalIgnore1() {
    int(0..AMax) A;
    int(0..BMax) B;
    int(0..CMax) C;
    int(0..DMax) D;
    {=
        A=DiscreteUniform(0,AMax),
        B=DiscreteUniform(0,BMax),
        C=DiscreteUniform(0,CMax)
    =};
    alt {
        :: when(A > B) {= C=A =}
        :: when(B > A) {= A=C =}
        :: when(A == B) {= target = true =}
    };
    {= target = A>D || B<D =}
}

ConditionalIgnore1()